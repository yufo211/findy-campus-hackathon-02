{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-ogiri",
  "main": "src/index.tsx",
  "compatibility_date": "2026-06-14",
  "compatibility_flags": ["nodejs_compat"],
  "ai": {
    "binding": "AI"
  },
  // 1台の端末を回して遊ぶゲームなので、状態はすべてブラウザ側にある。
  // サーバーはWorkers AIを叩くだけのステートレスなAPIで、Durable Objectは使わない。
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["CounterAgent"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["LobbyAgent", "RoomAgent"],
      "deleted_classes": ["CounterAgent"]
    },
    {
      "tag": "v3",
      "deleted_classes": ["LobbyAgent", "RoomAgent"]
    }
  ]
}
